generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OPERATOR
  ADVERTISER
}

enum BusStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum AdvertisingSpaceStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  FINISHED
  CANCELLED
}

enum TabletStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADVERTISER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  advertiser Advertiser?
}

model Company {
  id        String      @id @default(uuid())
  name      String
  cnpj      String?     @unique
  email     String?
  phone     String?
  address   String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  advertisers Advertiser[]
}

model Advertiser {
  id        String   @id @default(uuid())
  userId    String   @unique
  companyId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  company  Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  campaigns Campaign[]
}

model Bus {
  id        String     @id @default(uuid())
  code      String     @unique
  plate     String?
  model     String?
  line      String?
  status    BusStatus  @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  advertisingSpaces AdvertisingSpace[]
  tablets           Tablet[]
  campaignBuses     CampaignBus[]
}

model AdvertisingSpace {
  id          String                  @id @default(uuid())
  busId       String?
  name        String
  type        String
  description String?
  price       Decimal                 @db.Decimal(10, 2)
  status      AdvertisingSpaceStatus  @default(AVAILABLE)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  bus           Bus?            @relation(fields: [busId], references: [id], onDelete: SetNull)
  campaignSpaces CampaignSpace[]
}

model Campaign {
  id              String        @id @default(uuid())
  advertiserId    String
  name            String
  description     String?
  startDate       DateTime?
  endDate         DateTime?
  budget          Decimal       @db.Decimal(12, 2) @default(0)
  status          CampaignStatus @default(DRAFT)
  durationSeconds Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  advertiser    Advertiser      @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  media         Media[]
  impressions   Impression[]
  campaignBuses CampaignBus[]
  campaignSpaces CampaignSpace[]
}

model CampaignBus {
  id         String @id @default(uuid())
  campaignId String
  busId      String

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  bus      Bus      @relation(fields: [busId], references: [id], onDelete: Cascade)

  @@unique([campaignId, busId])
}

model CampaignSpace {
  id                  String @id @default(uuid())
  campaignId          String
  advertisingSpaceId  String

  campaign          Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  advertisingSpace  AdvertisingSpace  @relation(fields: [advertisingSpaceId], references: [id], onDelete: Cascade)

  @@unique([campaignId, advertisingSpaceId])
}

model Media {
  id             String   @id @default(uuid())
  campaignId     String
  fileName       String
  fileUrl        String
  fileType       String
  fileSize       Int
  durationSeconds Int?
  createdAt      DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model Tablet {
  id          String      @id @default(uuid())
  code        String      @unique
  busId       String?
  status      TabletStatus @default(ONLINE)
  lastSeenAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  bus        Bus?        @relation(fields: [busId], references: [id], onDelete: SetNull)
  impressions Impression[]
}

model Impression {
  id              String   @id @default(uuid())
  campaignId      String
  tabletId        String
  startedAt       DateTime @default(now())
  durationSeconds Int      @default(0)
  createdAt       DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  tablet   Tablet   @relation(fields: [tabletId], references: [id], onDelete: Cascade)
}
